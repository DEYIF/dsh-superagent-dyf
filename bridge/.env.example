# 小智控制台 -> 智能体 -> 编辑功能 -> MCP 接入点 里复制
MCP_ENDPOINT=wss://api.xiaozhi.me/mcp/?token=REPLACE_ME
# 注意：这个 token 等于密码，别提交、别烧进固件

# superagent 管理 API。必须 127.0.0.1，因为它只绑 loopback 并校验同源
# 端口取决于哪个 DSH 实例加载了 bundle：
#   SETUP.md 的独立 profile（推荐）是 3082；跑在默认 profile 里才是 6272
SUPERAGENT_BASE=http://127.0.0.1:3082/orchestrator/api

# 设备与发送者
DEVICE_ID=esp32-01
SOURCE_ID=voice
ACTOR_ID=owner
ACTOR_NAME=客厅音箱

# 轮询间隔（秒）
POLL_SECONDS=20

# 只有自建小智服务端才可能有"主动播报"接口；官方云留空
# XIAOZHI_PUSH_URL=http://127.0.0.1:8000/push/speak

# STATE_FILE=state.json
# DEBUG=1
